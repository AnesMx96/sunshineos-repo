#!/usr/bin/env bash
# Puts the Sunshine Hyprland desktop onto THIS (already installed) system from the sunshine-payload package.
#  - system files (Python venv in /opt, session files, dconf defaults, skeleton for NEW users): copied with rsync; a file that
#    already exists and differs is kept next to the new one as <name>.pre-sunshine
#  - existing users: Hyprland dotfiles are copied only where the user has none (nothing of theirs is overwritten)
# usage: sunshine-payload-apply            (root)
set -u
PAY=/usr/share/sunshine/hyprland/root
[ -d "$PAY" ] || { echo "payload not installed (pacman -S sunshine-payload)"; exit 1; }
mkdir -p /var/log/sunshine; exec > >(tee -a /var/log/sunshine/payload-apply.log) 2>&1
echo "== payload apply $(date)"
rsync -aH --keep-dirlinks --backup --suffix=.pre-sunshine "$PAY/" / || echo "WARN: payload copy reported errors"
groupadd -f i2c; groupadd -f input
command -v dconf >/dev/null && dconf update >/dev/null 2>&1
[ -x /usr/bin/sunshine-fastfetch-patch ] && /usr/bin/sunshine-fastfetch-patch || true
# existing users get the dotfiles they do not have yet (never overwritten)
while IFS=: read -r name _ uid gid _ home shell; do
  [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] && [ -d "$home" ] || continue
  case "$shell" in */nologin|*/false) continue;; esac
  rsync -a --ignore-existing --chown="$uid:$gid" "$PAY/etc/skel/" "$home/" && echo "dotfiles added for $name"
  usermod -aG i2c,input "$name" 2>/dev/null
done < /etc/passwd
echo "== done"
